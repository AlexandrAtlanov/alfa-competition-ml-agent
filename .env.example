# Шаблон локального окружения. Скопируй в .env и заполни.
# В проде платформа сама подставляет OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL.
# Код читает только переменные окружения и .env НЕ перетирает уже заданные значения.

# --- Вариант 1: Groq (облако) ---
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# --- Вариант 2: Ollama (локально) ---
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:7b

# --- Вариант 3: прокси организаторов (Qwen) ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://changellenge.up.railway.app/v1
# OPENAI_MODEL=qwen/qwen3.8-27b

# --- Общие настройки ---
OPENAI_MODEL=qwen/qwen3.8-27b
# Таймаут одного LLM-вызова (кроме генерации кода), сек.
LLM_TIMEOUT=120
# Генерация кода: пусто/0/none = ждать ответ без лимита.
LLM_CODE_TIMEOUT=
LLM_MAX_RETRIES=5
# 429 rate limit: 3 повтора с паузой 30 с (удобно для локального Groq).
LLM_RATE_LIMIT_RETRIES=3
LLM_RATE_LIMIT_WAIT=30
LLM_TEMPERATURE=0.2
LOG_DIR=logs
